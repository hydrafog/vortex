#!/usr/bin/env python3
import sys
import os

ALLOWED_ANNOTATIONS = ["TODO", "FIXME", "NOTE", "cSpell", "HACK", "OPTIMIZE"]

TRIPLE_QUOTE_MARKERS = ['"""', "'''"]

SUPPORTED_EXTENSIONS = {
    ".ts",
    ".tsx",
    ".vue",
    ".js",
    ".jsx",
    ".css",
    ".cpp",
    ".c",
    ".h",
    ".hpp",
    ".java",
    ".kt",
    ".go",
    ".rs",
    ".py",
    ".sh",
    ".yaml",
    ".yml",
    ".toml",
    ".rb",
    ".nix",
}


def _toggle_multiline_state(line, in_multiline, multiline_char):
    for marker in TRIPLE_QUOTE_MARKERS:
        count = line.count(marker)
        if count == 0:
            continue
        if not in_multiline:
            if count % 2 == 1:
                in_multiline = True
                multiline_char = marker
        elif marker == multiline_char:
            if count % 2 == 1:
                in_multiline = False
                multiline_char = None
    return in_multiline, multiline_char


def strip_comments(file_path):
    if not os.path.exists(file_path):
        print(f"File {file_path} not found")
        return

    ext = os.path.splitext(file_path)[1]
    if ext not in SUPPORTED_EXTENSIONS:
        return

    with open(file_path, "r", encoding="utf-8", errors="ignore") as f:
        lines = f.readlines()

    new_lines = []
    in_multiline = False
    multiline_char = None
    in_block_comment = False

    for line in lines:
        stripped = line.strip()

        if not stripped:
            new_lines.append(line)
            continue

        keep = any(annotation in line for annotation in ALLOWED_ANNOTATIONS)
        if keep:
            new_lines.append(line)
            continue

        if ext in [".py", ".sh", ".yaml", ".yml", ".toml", ".rb", ".nix"]:
            if stripped.startswith("#!"):
                new_lines.append(line)
                continue

            if ext == ".py":
                prev_state = in_multiline
                in_multiline, multiline_char = _toggle_multiline_state(
                    line, in_multiline, multiline_char
                )
                if in_multiline or prev_state:
                    new_lines.append(line)
                    continue

            if stripped.startswith("#"):
                continue
            if "#" in line:
                idx = -1
                for i, ch in enumerate(line):
                    if ch == "#" and (i == 0 or line[i - 1] != "\\"):
                        if (
                            line.count('"', 0, i) % 2 == 0
                            and line.count("'", 0, i) % 2 == 0
                            and line.count("`", 0, i) % 2 == 0
                        ):
                            idx = i
                            break
                if idx != -1:
                    line = line[:idx].rstrip() + "\n"
                    if not line.strip():
                        continue

        elif ext in [
            ".js",
            ".ts",
            ".jsx",
            ".tsx",
            ".vue",
            ".css",
            ".cpp",
            ".c",
            ".h",
            ".hpp",
            ".java",
            ".kt",
            ".go",
            ".rs",
        ]:
            if in_block_comment:
                if "*/" in line:
                    in_block_comment = False
                    idx = line.find("*/") + 2
                    line = line[idx:]
                    if not line.strip():
                        continue
                else:
                    continue

            if "/*" in line and "*/" in line:
                start_idx = line.find("/*")
                end_idx = line.find("*/", start_idx)
                if (
                    line.count('"', 0, start_idx) % 2 == 0
                    and line.count("'", 0, start_idx) % 2 == 0
                    and line.count("`", 0, start_idx) % 2 == 0
                ):
                    remainder = line[end_idx + 2:].rstrip()
                    line = line[:start_idx].rstrip() + ((" " + remainder) if remainder and line[:start_idx].strip() else remainder) + "\n"
                    if not line.strip():
                        continue

            elif "/*" in line:
                start_idx = line.find("/*")
                if (
                    line.count('"', 0, start_idx) % 2 == 0
                    and line.count("'", 0, start_idx) % 2 == 0
                    and line.count("`", 0, start_idx) % 2 == 0
                ):
                    in_block_comment = True
                    line = line[:start_idx].rstrip() + "\n"
                    if not line.strip():
                        continue

            if stripped.startswith("//"):
                continue
            if "//" in line:
                idx = line.find("//")
                if (
                    line.count('"', 0, idx) % 2 == 0
                    and line.count("'", 0, idx) % 2 == 0
                    and line.count("`", 0, idx) % 2 == 0
                ):
                    line = line[:idx].rstrip() + "\n"
                    if not line.strip():
                        continue

        new_lines.append(line.rstrip() + "\n" if line.strip() else "\n")

    if new_lines != lines:
        with open(file_path, "w", encoding="utf-8") as f:
            f.writelines(new_lines)


if __name__ == "__main__":
    for arg in sys.argv[1:]:
        if os.path.isdir(arg):
            for root, dirs, files in os.walk(arg):
                dirs[:] = [
                    d
                    for d in dirs
                    if not d.startswith(".")
                    and d not in ("node_modules", "target", "build", "dist")
                ]
                for file in files:
                    ext = os.path.splitext(file)[1]
                    if ext in SUPPORTED_EXTENSIONS:
                        strip_comments(os.path.join(root, file))
        else:
            strip_comments(arg)
