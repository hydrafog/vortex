#!/usr/bin/env python3
import sys
import os
import argparse

DEFAULT_LIMIT = int(os.getenv("LINE_LIMIT", "600"))

def count_production_lines(file_path):
    if not os.path.exists(file_path):
        return 0

    with open(file_path, "r", encoding="utf-8", errors="ignore") as f:
        lines = f.readlines()

    prod_lines = 0
    for line in lines:
        stripped = line.strip()
        if not stripped or stripped.startswith("//") or stripped.startswith("/*") or stripped.startswith("*") or stripped.startswith("#"):
            continue
        prod_lines += 1

    return prod_lines

LEGACY_ALLOWLIST = {
    "linux/daemon/src/core/audio_orchestrator.rs",
    "linux/daemon/src/core/ble/audio_signal.rs",
    "linux/daemon/src/core/storage/peers.rs",
    "linux/daemon/src/main.rs",
    "android/app/src/main/java/com/vortex/a3/core/ble/GattServer.kt",
    "android/app/src/main/java/com/vortex/a3/core/lan/LanServer.kt",
}

def main():
    parser = argparse.ArgumentParser(description="Check source files for maximum line limit.")
    parser.add_argument("--limit", type=int, default=DEFAULT_LIMIT, help="Maximum allowed production lines per file (default: 600)")
    parser.add_argument("paths", nargs="*", help="File or directory paths to check")

    args = parser.parse_args()
    limit = args.limit
    exit_code = 0

    supported_exts = (".ts", ".tsx", ".js", ".jsx", ".vue", ".css", ".rs", ".kt", ".py", ".sh")
    files = []
    for arg in args.paths:
        if os.path.isdir(arg):
            for root, _, filenames in os.walk(arg):
                for fn in filenames:
                    if fn.endswith(supported_exts):
                        files.append(os.path.join(root, fn))
        elif arg.endswith(supported_exts):
            files.append(arg)

    for file_path in files:
        norm_path = os.path.relpath(file_path).replace("\\", "/")
        if norm_path in LEGACY_ALLOWLIST:
            continue
        count = count_production_lines(file_path)
        if count > limit:
            print(f"[Warning] {file_path} has {count} production lines (limit {limit})")
            print("  Recommendation: split into smaller modules/components.")
            exit_code = 1

    if exit_code == 0:
        print(f"[Pass] Checked {len(files)} files against line limit ({limit} lines max).")

    sys.exit(exit_code)

if __name__ == "__main__":
    main()
