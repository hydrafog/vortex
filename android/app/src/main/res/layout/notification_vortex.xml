<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingTop="4dp"
    android:paddingBottom="4dp"
    android:paddingStart="4dp"
    android:paddingEnd="4dp">

    <!-- Laptop Status Chip -->
    <LinearLayout
        android:id="@+id/notification_laptop_group"
        android:layout_width="wrap_content"
        android:layout_height="32dp"
        android:background="@drawable/bg_notification_chip"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="10dp"
        android:paddingEnd="10dp">

        <ImageView
            android:id="@+id/notification_laptop_icon"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_marginEnd="6dp"
            android:src="@drawable/ic_notification_laptop"
            android:tint="@android:color/white" />

        <TextView
            android:id="@+id/notification_laptop_battery"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="--"
            android:textColor="@android:color/white"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Earbuds Audio Switch Chip -->
    <LinearLayout
        android:id="@+id/notification_audio_group"
        android:layout_width="wrap_content"
        android:layout_height="32dp"
        android:layout_marginStart="8dp"
        android:background="@drawable/bg_notification_button"
        android:clickable="true"
        android:focusable="false"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="10dp"
        android:paddingEnd="10dp">

        <ImageView
            android:id="@+id/notification_audio_icon"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_marginEnd="6dp"
            android:src="@drawable/ic_notification_earbuds"
            android:tint="@android:color/white" />

        <TextView
            android:id="@+id/notification_audio_battery"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="--"
            android:textColor="@android:color/white"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Lock / Unlock Action Button -->
    <FrameLayout
        android:id="@+id/notification_lock_group"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_marginStart="8dp"
        android:background="@drawable/bg_notification_button"
        android:clickable="true"
        android:focusable="false"
        android:visibility="gone">

        <ImageView
            android:id="@+id/notification_lock_icon"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_notification_lock_open"
            android:tint="@android:color/white" />
    </FrameLayout>

    <!-- Spacer: pushes clipboard quick-send button to far right -->
    <TextView
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1" />

    <!-- Send Clipboard Action Button -->
    <FrameLayout
        android:id="@+id/notification_clipboard_group"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_marginStart="8dp"
        android:background="@drawable/bg_notification_button"
        android:clickable="true"
        android:focusable="false"
        android:visibility="gone">

        <ImageView
            android:id="@+id/notification_clipboard_icon"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_notification_clipboard"
            android:tint="@android:color/white" />
    </FrameLayout>

</LinearLayout>
